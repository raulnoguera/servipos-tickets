<?php
require getenv('HOME').'/domains/firebrick-quail-381357.hostingersite.com/public_html/vendor/autoload.php';
$app = require getenv('HOME').'/domains/firebrick-quail-381357.hostingersite.com/public_html/bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
// Diagnóstico: envía 2 notificaciones y muestra la respuesta de Google.
$s = App\Models\PushSubscription::first();
$ticket = App\Models\Ticket::firstWhere('number', 'TK-2026-00192')->load(['atm', 'faultType']);
$messages = [
    ['title' => 'Prueba de diagnóstico 1', 'body' => 'Si ve esto, las notificaciones llegan.', 'url' => '/', 'tag' => 'diag-1'],
    ['title' => "Nuevo ticket {$ticket->number}", 'body' => implode(' · ', array_filter(["ATM {$ticket->atm->atm_number}", $ticket->atm->agency_name, $ticket->faultType?->name])), 'url' => "/tickets/{$ticket->id}", 'tag' => $ticket->number . '-diag'],
];
$wp = new Minishlink\WebPush\WebPush(['VAPID' => ['subject' => config('services.webpush.subject'), 'publicKey' => config('services.webpush.public_key'), 'privateKey' => config('services.webpush.private_key')]], ['TTL' => 43200, 'urgency' => 'high']);
foreach ($messages as $m) {
    $r = $wp->sendOneNotification(Minishlink\WebPush\Subscription::create(['endpoint' => $s->endpoint, 'publicKey' => $s->public_key, 'authToken' => $s->auth_token, 'contentEncoding' => 'aes128gcm']), json_encode($m, JSON_UNESCAPED_UNICODE));
    echo $m['title'], ' => ', $r->isSuccess() ? 'ACEPTADA' : 'RECHAZADA', ' HTTP ', $r->getResponse()?->getStatusCode(), ' ', $r->getReason(), PHP_EOL;
    sleep(3);
}
echo 'payload ticket: ', json_encode($messages[1], JSON_UNESCAPED_UNICODE), PHP_EOL;
