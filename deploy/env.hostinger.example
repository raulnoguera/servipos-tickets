# Copiar como .env en el servidor y completar los valores que dicen CAMBIAR
APP_NAME="ServiPos Tickets"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CAMBIAR-DOMINIO.hostingersite.com
APP_TIMEZONE=America/Caracas
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

LOG_CHANNEL=daily
LOG_LEVEL=notice

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CAMBIAR_BD
DB_USERNAME=CAMBIAR_BD
DB_PASSWORD=CAMBIAR

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=CAMBIAR-DOMINIO.hostingersite.com

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Administrador inicial (php artisan db:seed --force)
ADMIN_NAME=Administrador
ADMIN_EMAIL=CAMBIAR@servipos2019.com
ADMIN_PASSWORD=CAMBIAR

# Solo para el ambiente de pruebas: usuarios y tickets de demostración
DEMO_PASSWORD=CAMBIAR

# Notificaciones push (php artisan servipos:claves-push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@servipos2019.com

# Lectura del buzón de reportes de los bancos (se configura con deploy/configurar-correo.sh).
INBOUND_MAIL_HOST=
INBOUND_MAIL_PORT=993
INBOUND_MAIL_ENCRYPTION=ssl
INBOUND_MAIL_USERNAME=
INBOUND_MAIL_PASSWORD=
INBOUND_MAIL_DOMAINS=bncenlinea.net
INBOUND_MAIL_SINCE=
