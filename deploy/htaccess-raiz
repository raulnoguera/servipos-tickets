# La carpeta pública del dominio (public_html) contiene todo el proyecto.
# Todo se redirige a /public, así .env, vendor y storage nunca quedan expuestos.
# Sin <IfModule>: si el servidor no tuviera mod_rewrite, el sitio da error en vez de
# quedar abierto. Cada carpeta interna lleva además su propio "Require all denied".
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
Options -Indexes
